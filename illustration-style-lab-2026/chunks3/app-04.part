    '의상 디자인':'실루엣·소재·포인트 색을 먼저 정하고 디테일을 더한다.',
    '완성도 유지':'작업을 러프·정리·채색·마감 네 단계로 나누고 종료 기준을 적는다.',
    '작업 속도':'30분 컬러 러프를 세 번 반복해 결정 시간을 줄인다.',
    '파일 정리':'레이어 이름과 폴더 구조를 작업 시작 전에 템플릿으로 만든다.'
  };

  const styleFieldDefaults={
    lyrical:['editorial','book','personalArtist'],cleanCell:['webtoonColor','webtoonCharacter','mascot'],lineDrawing:['webtoonScene','editorial','personalArtist'],painterly:['characterIllust','gameKeyArt','personalArtist'],cinematic:['gameKeyArt','keyVisual','motion'],graphicPop:['poster','keyVisual','uiIllustration'],fashion:['fashionBeauty','characterDesign','characterIllust'],roundIP:['mascot','goods','uiIllustration'],surreal:['characterDesign','visualDev','personalArtist'],semiReal:['characterIllust','editorial','fashionBeauty'],worldBuild:['environment','visualDev','webtoonScene'],objectStory:['propDesign','editorial','book'],narrativeScene:['webtoonScene','storyboard','snsSeries'],actionPerspective:['gameKeyArt','storyboard','webtoonScene'],ornamental:['pattern','poster','goods'],fusion:['personalArtist','keyVisual','snsSeries']
  };

  function buildResult(){
    syncProfile();syncReference();saveState();
    const computed=compute();
    const top=computed.ranked.slice(0,3);
    const main=top[0], second=top[1];
    $('#resultComposite').textContent=main.id==='fusion'?`${main.name} · 현재 조합을 찾는 중`:`${main.name} × ${second.name}`;
    $('#resultSummary').textContent=main.id==='fusion'?main.summary:`${main.summary} ${second.name}의 특징도 함께 나타나며, 다음 작업에서는 두 방향에서 한 요소씩 골라 실제로 시험해보는 것이 좋다.`;
    const tags=[...new Set(top.flatMap(s=>s.tags))].slice(0,9);
    $('#resultTagRow').innerHTML=tags.map(t=>`<span>${t}</span>`).join('');
    drawRadar(computed.radar);
    $('#styleCards').innerHTML=top.map((s,i)=>`<article class="style-card"><span class="rank">${String(i+1).padStart(2,'0')}</span><h4>${s.name}</h4><p>${s.summary}</p><div class="tag-row">${s.tags.map(t=>`<span>${t}</span>`).join('')}</div><div class="notice" style="margin-top:14px"><b>첫 실험</b><br>${s.quest}</div></article>`).join('');
    renderDualBars(computed.radar);
    renderCoverage(computed);
    renderPriorities(computed,top);
    renderFieldResults(top);
    renderReferenceReport();
    renderSources();
  }

  function drawRadar(rows){
    const svg=$('#radarChart'); const cx=210,cy=210,r=148,n=rows.length;
    const pt=(i,val)=>{const a=-Math.PI/2+(i/n)*Math.PI*2;const rr=r*(val/100);return [cx+Math.cos(a)*rr,cy+Math.sin(a)*rr];};
    const poly=vals=>vals.map((v,i)=>pt(i,v).join(',')).join(' ');
    let html='';
    [20,40,60,80,100].forEach(v=>{html+=`<polygon points="${poly(Array(n).fill(v))}" fill="none" stroke="rgba(173,191,218,.16)" stroke-width="1"/>`;});
    rows.forEach((row,i)=>{const end=pt(i,100);const label=pt(i,118);html+=`<line x1="${cx}" y1="${cy}" x2="${end[0]}" y2="${end[1]}" stroke="rgba(173,191,218,.13)"/><text x="${label[0]}" y="${label[1]}" fill="#aebcd0" font-size="12" text-anchor="middle" dominant-baseline="middle">${row.label}</text>`;});
    html+=`<polygon points="${poly(rows.map(r=>r.experience))}" fill="rgba(255,143,198,.16)" stroke="#ff8fc6" stroke-width="2"/>`;
    html+=`<polygon points="${poly(rows.map(r=>r.preference))}" fill="rgba(98,212,255,.16)" stroke="#62d4ff" stroke-width="3"/>`;
    rows.forEach((row,i)=>{const p=pt(i,row.preference);html+=`<circle cx="${p[0]}" cy="${p[1]}" r="4" fill="#62d4ff"/>`;});
    svg.innerHTML=html;
  }
  function renderDualBars(rows){
    $('#preferenceExperience').innerHTML=`<div class="bar-labels"><span></span><span>선호</span><span>경험</span></div>${rows.map(r=>`<div class="dual-row"><span>${r.label}</span><div class="mini-bar pref" title="선호 ${r.preference}"><i style="width:${r.preference}%"></i></div><div class="mini-bar exp" title="경험 ${r.experience}"><i style="width:${r.experience}%"></i></div></div>`).join('')}`;
  }
  function renderCoverage(computed){
    const repeated=Object.entries(state.experience).filter(([,v])=>Number(v)>=2).sort((a,b)=>b[1]-a[1]).map(([k])=>k);
    const first=Object.entries(state.experience).filter(([,v])=>Number(v)===1).map(([k])=>k);
    const rangeCounts=Object.entries(state.ranges).filter(([,arr])=>arr.length).map(([k,arr])=>`${k} ${arr.length}개`);
    const highLow=computed.ranked.filter(s=>s.score>=65&&s.experience<40).slice(0,3);
    $('#coverageSummary').innerHTML=`
      <div class="coverage-block"><h4>혼자 완성하거나 반복해본 작업</h4>${repeated.length?`<ul>${repeated.slice(0,9).map(v=>`<li>${v}</li>`).join('')}</ul>`:'<p class="empty">아직 2단계 이상으로 체크한 작업이 적다.</p>'}</div>
      <div class="coverage-block"><h4>자료를 보며 시작해본 작업</h4>${first.length?`<div class="tag-row">${first.slice(0,8).map(v=>`<span>${v}</span>`).join('')}</div>`:'<p class="empty">체크한 항목이 없다.</p>'}</div>
