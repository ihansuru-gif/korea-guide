  function renderToggleButtons(selector,items,selected,setter){
    const root=$(selector); root.innerHTML=items.map(label=>`<button type="button" data-label="${esc(label)}" class="${selected.includes(label)?'active':''}">${label}</button>`).join('');
    root.onclick=e=>{const btn=e.target.closest('button[data-label]'); if(!btn)return; const label=unesc(btn.dataset.label); const next=selected.includes(label)?selected.filter(x=>x!==label):[...selected,label]; setter(next); selected=next; btn.classList.toggle('active'); saveState();};
  }

  function renderFields(){
    const root=$('#fieldGroups');
    root.innerHTML=D.fieldGroups.map(g=>`<section class="field-group"><header><div><h3>${g.title}</h3><p>관심 있는 결과물과 작업 분야를 고릅니다.</p></div><span class="mini-kicker">최대 8개</span></header><div class="field-card-grid">${g.fields.map(f=>`<label class="field-card ${state.fields.includes(f.id)?'active':''}" data-field="${f.id}"><input type="checkbox" ${state.fields.includes(f.id)?'checked':''}><i>${state.fields.includes(f.id)?'✓':'+'}</i><b>${f.name}</b><span>${f.desc}</span></label>`).join('')}</div></section>`).join('');
    root.onclick=e=>{const card=e.target.closest('.field-card'); if(!card)return; e.preventDefault(); const id=card.dataset.field; if(state.fields.includes(id)){state.fields=state.fields.filter(x=>x!==id);}else{if(state.fields.length>=8)return alert('활용 분야는 최대 8개까지 고를 수 있어요.'); state.fields.push(id);} saveState(); renderFields();};
  }

  function compute(){
    const pref=Object.fromEntries(D.styles.map(s=>[s.id,0]));
    const exp=Object.fromEntries(D.styles.map(s=>[s.id,0]));
    // comparisons
    D.comparisons.forEach((q,i)=>{
      const v=state.comparisons[i]; if(v===null||v===undefined)return;
      if(v<0) q.a.styles.forEach(id=>pref[id]+=Math.abs(v)*3.2);
      if(v>0) q.b.styles.forEach(id=>pref[id]+=Math.abs(v)*3.2);
      if(v===0){q.a.styles.forEach(id=>pref[id]+=1.6);q.b.styles.forEach(id=>pref[id]+=1.6);}
    });
    // spectrum
    D.spectrumGroups.forEach(g=>g.items.forEach(item=>{
      const value=Number(state.spectrum[item.id]||3);
      Object.entries(item.weights).forEach(([id,w])=>pref[id]+=(value-1)*w*1.45);
    }));
    // details
    D.detailGroups.forEach(g=>{
      const selected=state.details[g.title]||[];
      g.items.forEach(([label,ids])=>{if(selected.includes(label))ids.forEach(id=>pref[id]+=2.6);});
    });
    // experience
    D.experienceGroups.forEach(g=>g.items.forEach(([label,ids])=>{
      const level=Number(state.experience[label]||0); ids.forEach(id=>exp[id]+=level*3.2);
    }));
    // breadth/fusion
    const selectedDetails=Object.values(state.details).flat().length;
    const exploredGroups=Object.values(state.details).filter(a=>a.length>0).length;
    const fieldBreadth=new Set(state.fields.map(fieldGroupOf)).size;
    pref.fusion += exploredGroups*1.15 + Math.min(7,selectedDetails/6) + fieldBreadth*.8;
    exp.fusion += D.experienceGroups.flatMap(g=>g.items).filter(([label])=>(state.experience[label]||0)>=2).length*.28;
    const prefNorm=normalize(pref), expNorm=normalize(exp);
    const ranked=D.styles.map(s=>({...s,raw:pref[s.id],score:prefNorm[s.id],experience:expNorm[s.id]})).sort((a,b)=>b.score-a.score);
    // If many strong directions are tightly packed, move fusion upward but keep meaningful main result.
    const close=ranked.filter(r=>r.id!=='fusion'&&r.score>=Math.max(55,ranked[0].score-12)).length;
    if(close>=6){prefNorm.fusion=Math.max(prefNorm.fusion,78);const f=ranked.find(r=>r.id==='fusion');f.score=prefNorm.fusion;ranked.sort((a,b)=>b.score-a.score);}
    const radar=D.radarAxes.map(a=>({
      ...a,
      preference:avg(a.styles.map(id=>prefNorm[id]||0)),
      experience:avg(a.styles.map(id=>expNorm[id]||0))
    }));
    return {pref,exp,prefNorm,expNorm,ranked,radar};
  }

  function normalize(obj){
    const vals=Object.values(obj); const max=Math.max(1,...vals); return Object.fromEntries(Object.entries(obj).map(([k,v])=>[k,Math.round((v/max)*100)]));
  }
  const avg=arr=>arr.length?Math.round(arr.reduce((a,b)=>a+b,0)/arr.length):0;

